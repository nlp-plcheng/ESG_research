# 正式 profile。複製成 env.prod.sh、填好空格；env.prod.sh「絕對不要」commit 或分享——
# 裡面有 secret key、後台金鑰、以及參與者代號名單（每個代號等同一組登入帳密）。
#   cp env.prod.sh.example env.prod.sh && source env.prod.sh

# --- 資料在哪 -------------------------------------------------------------------
# 預設值見 config.py 的 RESULT_DIR / PDF_DIR。必要的檔案結構：
#   <result_dir>/<公司>/summary.json     （openai_build_summary_json.py 的輸出）
#   <pdf_dir>/<公司>/<民國年>.pdf         （報告書；年份與 summary.json 內的 year 一致）
# export ESG_RESULT_DIR=/path/to/result
# export ESG_PDF_DIR=/path/to/pdf
export ESG_DB_PATH=/var/tmp/esg_annotation/annotation.db   # 只能放本機磁碟，不能放 NFS/SMB
# port 固定在 run.sh / restart_web.sh / launch.sh 開頭的 PORT=8080（英文版預設 8081）

# --- 密鑰（run.sh prod-init 會自動填；launch.sh 也會補空值）-------------------------
export ESG_SECRET_KEY=            # python -c 'import secrets;print(secrets.token_hex(32))'
export ESG_ADMIN_KEY=             # python -c 'import secrets;print(secrets.token_hex(16))'

# --- 研究模式 -------------------------------------------------------------------
# 自招募／志願標註者（專屬連結、無報酬）：
export ESG_VOLUNTEER_MODE=1       # 同意書／完成頁不出現 Prolific／報酬字樣
export ESG_ALLOW_LOCAL_PID=1      # 專屬連結 https://<host>/?pid=alice01
export ESG_TASKS_PER_SESSION=0    # 0 = 每人不設上限，想停就停
export ESG_PROLIFIC_CODE=CHANGEME # 佔位；Prolific 研究才需要填 completion code
export ESG_PROLIFIC_SCREENOUT_CODE=
# 改成付費 Prolific 研究：ESG_VOLUNTEER_MODE=0、ESG_ALLOW_LOCAL_PID=0、
# ESG_TASKS_PER_SESSION=10、ESG_PROLIFIC_CODE=<completion code>。

# --- 誰能進來 -------------------------------------------------------------------
# 逗號分隔的代號；一人一條連結，代號就是唯一的憑證。`bash add_pids.sh 6` 可產生隨機代號。
export ESG_PID_ALLOWLIST=self-check
export ESG_TEST_PIDS=self-check   # 測試帳號：看全部題目、不佔名額、不進匯出
export ESG_N_ANNOTATORS=0         # 標註總人數：>0 等量分配（0 = 先到先做）

# --- 每題標幾份 -------------------------------------------------------------------
export ESG_REDUNDANCY=3           # 每道異常題幾人
export ESG_REDUNDANCY_CONTROL=3   # 每道對照題幾人（1 省時；0 = 不發對照題）
export ESG_CALIBRATION_N=5        # 所有人先做的共同校準題數（自動挑異常分數最高的前 N 題）
# export ESG_GOLD_FILE=gold5.json # 改用自訂校準題清單（格式見 ingest.LoadGold）；設了之後 restart_web.sh 也沿用
export ESG_ANOMALY_RATIO=1.0      # 先到先做模式：異常題的配比
export ESG_PROGRESSIVE_REVEAL=1   # 逐年解鎖（滑桿預設承接前一年）
export ESG_GOLD_EVERY=0
export ESG_MIN_SECONDS_TASK=40    # 只記錄，不設閘門

# --- 對外服務 -------------------------------------------------------------------
export ESG_BEHIND_PROXY=1         # 經 cloudflared / nginx（secure cookie、X-Forwarded-*）

# --- 固定連結頁（選用；用免費 quick tunnel 時建議設）--------------------------------
# quick tunnel 每次啟動網址都會變。tunnel_loop.sh 會自動重開，publish_link.sh 把新網址寫進
# GitHub Pages 上的一頁小轉址頁，標註者手上的連結就永遠不變。這台機器的 git push 必須免密碼（SSH key）。
# export ESG_LINK_REPO_DIR=$HOME/esg-link                    # Pages repo 的本機 clone
# export ESG_LINK_PAGE_URL=https://<you>.github.io/esg-link/  # 固定連結（run.sh links 會印）

if [ -z "$ESG_SECRET_KEY" ] || [ -z "$ESG_ADMIN_KEY" ]; then
  echo "WARNING: 上線前先填 ESG_SECRET_KEY / ESG_ADMIN_KEY（run.sh prod-init 會自動填）" >&2
fi
