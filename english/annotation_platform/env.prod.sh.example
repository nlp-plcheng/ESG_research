# Production profile. Copy to env.prod.sh, fill in the blanks, and NEVER commit
# or share env.prod.sh -- it holds the secret key, the admin key and the list
# of participant ids (each id is effectively a login).
#   cp env.prod.sh.example env.prod.sh && source env.prod.sh

# --- Where the data is --------------------------------------------------------
# Defaults: the result/ and pdf/ folders next to annotation_platform/, i.e. the
# edition folder the pipeline was run from. Required layout:
#   <result_dir>/<company>/summary.json    (openai_build_summary_json.py output)
#   <pdf_dir>/<company>/<year>.pdf         (the reports; <year> as in summary.json)
# export ESG_RESULT_DIR=/path/to/result
# export ESG_PDF_DIR=/path/to/pdf
export ESG_DB_PATH=/var/tmp/esg_annotation_en/annotation.db   # local disk only, never NFS/SMB
# Port: not set here -- export ESG_PORT in your shell before running run.sh /
# launch.sh / restart_web.sh (default 8081).
export ESG_YEAR_STYLE=roc         # roc: years are ROC/Minguo (109 = 2020); ad: Gregorian (2020)

# --- Secrets (run.sh prod-init fills these in automatically) ------------------
export ESG_SECRET_KEY=            # python -c 'import secrets;print(secrets.token_hex(32))'
export ESG_ADMIN_KEY=             # python -c 'import secrets;print(secrets.token_hex(16))'

# --- Study mode ---------------------------------------------------------------
# In-house / volunteer annotators (personal links, no payment):
export ESG_VOLUNTEER_MODE=1       # consent/done pages without Prolific / payment wording
export ESG_ALLOW_LOCAL_PID=1      # personal links like https://<host>/?pid=alice01
export ESG_TASKS_PER_SESSION=0    # 0 = no per-person cap, stop whenever
export ESG_PROLIFIC_CODE=CHANGEME # placeholder; set the completion code for a Prolific run
export ESG_PROLIFIC_SCREENOUT_CODE=
# For a paid Prolific run instead: ESG_VOLUNTEER_MODE=0, ESG_ALLOW_LOCAL_PID=0,
# ESG_TASKS_PER_SESSION=10, ESG_PROLIFIC_CODE=<completion code>.

# --- Who may enter ------------------------------------------------------------
# Comma-separated ids; each person gets their own link and the ids are the
# only credential. `bash add_pids.sh 6` generates random ones.
export ESG_PID_ALLOWLIST=self-check
export ESG_TEST_PIDS=self-check   # test accounts: see everything, hold no slot, excluded from exports
export ESG_N_ANNOTATORS=0         # total annotators: balanced equal-count allocation (0 = first come)

# --- How much each item is annotated -------------------------------------------
export ESG_REDUNDANCY=3           # people per flagged (suspicious) item
export ESG_REDUNDANCY_CONTROL=3   # people per control item (1 saves time; 0 = skip controls)
export ESG_CALIBRATION_N=5        # shared calibration items everyone does first (automatic pick: the top N by anomaly score)
# export ESG_GOLD_FILE=gold5.json # curated calibration set instead (format: ingest.LoadGold); kept across restarts
export ESG_ANOMALY_RATIO=1.0      # first-come mode: share of flagged items served first
export ESG_PROGRESSIVE_REVEAL=1   # years unlock one by one (slider defaults to the previous year)
export ESG_GOLD_EVERY=0
export ESG_MIN_SECONDS_TASK=40    # recorded only; no gate

# --- Serving --------------------------------------------------------------------
export ESG_BEHIND_PROXY=1         # served through cloudflared / nginx (secure cookies, X-Forwarded-*)

# --- Fixed link page (optional, recommended with the free quick tunnel) ---------
# A quick tunnel gets a new random address every time it starts. tunnel_loop.sh
# restarts it automatically and publish_link.sh writes the new address into a
# tiny redirect page in a GitHub Pages repo, so the link annotators hold never
# changes. `git push` from this machine must work without a prompt (SSH key).
# export ESG_LINK_REPO_DIR=$HOME/esg-link                    # local clone of the Pages repo
# export ESG_LINK_PAGE_URL=https://<you>.github.io/esg-link/  # the stable link (run.sh links prints it)

if [ -z "$ESG_SECRET_KEY" ] || [ -z "$ESG_ADMIN_KEY" ]; then
  echo "WARNING: fill in ESG_SECRET_KEY / ESG_ADMIN_KEY before going live (run.sh prod-init does it)" >&2
fi
